-- 10. Weather Observation Station 5
-- ==========================================
-- Problem: Weather Observation Station 5
-- Difficulty: Easy
-- Topic: ORDER BY, LIMIT, UNION

(SELECT CITY, LENGTH(CITY)
 FROM STATION
 ORDER BY LENGTH(CITY) ASC, CITY ASC
 LIMIT 1)
UNION
(SELECT CITY, LENGTH(CITY)
 FROM STATION
 ORDER BY LENGTH(CITY) DESC, CITY ASC
 LIMIT 1);


